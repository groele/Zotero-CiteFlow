{
    "manifest_version": 2,
    "name": "Zotero CiteFlow",
    "version": "12.5.3",
    "description": "Track Word citations and connect them to Zotero items.",
    "homepage_url": "https://github.com/groele/Zotero-CiteFlow",
    "author": "Zotero CiteFlow",
    "icons": {
        "16": "chrome/content/icons/icon-16.png",
        "32": "chrome/content/icons/icon-32.png",
        "48": "chrome/content/icons/favicon@0.5x.png",
        "64": "chrome/content/icons/icon-64.png",
        "96": "chrome/content/icons/favicon.png",
        "128": "chrome/content/icons/icon-128.png"
    },
    "applications": {
        "zotero": {
            "id": "citeflow@groele",
            "strict_min_version": "8.0",
            "strict_max_version": "11.0.*",
            "update_url": "https://raw.githubusercontent.com/groele/Zotero-CiteFlow/main/update.json"
        }
    }
}
