{
    "manifest_version": 2,
    "name": "Zotero CiteFlow",
    "version": "10.0.0",
    "description": "Reference and citation tracking for Zotero and Word",
    "homepage_url": "https://github.com/groele/Zotero-CiteFlow",
    "author": "Polygon; V30 integration by Hou",
    "icons": {
        "48": "chrome/content/icons/favicon@0.5x.png",
        "96": "chrome/content/icons/favicon.png"
    },
    "applications": {
        "zotero": {
            "id": "citeflow@groele",
            "strict_min_version": "8.0",
            "strict_max_version": "11.0.*",
            "update_url": "https://raw.githubusercontent.com/groele/Zotero-CiteFlow/main/update.json"
        }
    }
}
